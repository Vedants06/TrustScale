# Load Balancer
LB_PORT=8000
REDIS_URL=redis://localhost:6379
ML_SERVICE_URL=http://localhost:8100
TRUST_STRATEGY=trust_aware
QUARANTINE_THRESHOLD=0.30
QUARANTINE_INITIAL_DURATION=60
BOOTSTRAP_MAX_INITIAL=0.5
LOG_LEVEL=INFO

# Node
NODE_ID=node_1
NODE_PORT=8001
LB_URL=http://localhost:8000
BEHAVIOR_MODE=honest
BEHAVIOR_INTENSITY=0.5
REPORT_INTERVAL_SECONDS=5

# ML Service
ML_PORT=8100
PROMETHEUS_URL=http://localhost:9090
MODEL_PATH=/models/lstm_v1.pt
RETRAIN_INTERVAL_MINUTES=30

# Attack Orchestrator
ORCHESTRATOR_PORT=8200
SCENARIOS_DIR=/config/attack_scenarios

# Traffic Generator
TARGET_URL=http://localhost:8000
TRAFFIC_PATTERN=steady_state
STEADY_STATE_USERS=10
STEADY_STATE_SPAWN_RATE=2
STEADY_STATE_DURATION_SECONDS=300
MORNING_RAMP_START_USERS=1
MORNING_RAMP_TARGET_USERS=20
MORNING_RAMP_SPAWN_RATE=2
MORNING_RAMP_DURATION_SECONDS=180
MORNING_RAMP_HOLD_SECONDS=120