{
    "title": "TrustScale - Trust Scores",
    "uid": "trustscale-trust",
    "version": 2,
    "schemaVersion": 36,
    "refresh": "5s",
    "time": {
        "from": "now-15m",
        "to": "now"
    },
    "panels": [
        {
            "id": 1,
            "title": "Trust Score per Node",
            "type": "gauge",
            "gridPos": {
                "x": 0,
                "y": 0,
                "w": 12,
                "h": 8
            },
            "options": {
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "minVizWidth": 120,
                "minVizHeight": 120,
                "orientation": "auto",
                "showThresholdLabels": false,
                "showThresholdMarkers": true
            },
            "fieldConfig": {
                "defaults": {
                    "min": 0,
                    "max": 1,
                    "decimals": 2,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "value": null,
                                "color": "dark-red"
                            },
                            {
                                "value": 0.3,
                                "color": "red"
                            },
                            {
                                "value": 0.5,
                                "color": "orange"
                            },
                            {
                                "value": 0.7,
                                "color": "yellow"
                            },
                            {
                                "value": 0.85,
                                "color": "green"
                            }
                        ]
                    },
                    "color": {
                        "mode": "thresholds"
                    }
                },
                "overrides": []
            },
            "targets": [
                {
                    "expr": "trustscale_node_trust_score",
                    "legendFormat": "{{node_id}}",
                    "refId": "A"
                }
            ]
        },
        {
            "id": 2,
            "title": "Trust Score Over Time",
            "type": "timeseries",
            "gridPos": {
                "x": 12,
                "y": 0,
                "w": 12,
                "h": 8
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "desc"
                }
            },
            "fieldConfig": {
                "defaults": {
                    "min": 0,
                    "max": 1,
                    "decimals": 2,
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "drawStyle": "line",
                        "lineWidth": 2,
                        "fillOpacity": 0,
                        "gradientMode": "none",
                        "lineInterpolation": "smooth",
                        "showPoints": "never",
                        "pointSize": 5,
                        "spanNulls": true,
                        "thresholdsStyle": {
                            "mode": "off"
                        }
                    }
                },
                "overrides": []
            },
            "targets": [
                {
                    "expr": "trustscale_node_trust_score",
                    "legendFormat": "{{node_id}}",
                    "refId": "A"
                }
            ]
        },
        {
            "id": 3,
            "title": "Discrepancy Over Time",
            "type": "timeseries",
            "gridPos": {
                "x": 0,
                "y": 8,
                "w": 12,
                "h": 8
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "desc"
                }
            },
            "fieldConfig": {
                "defaults": {
                    "min": 0,
                    "max": 2,
                    "decimals": 3,
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "drawStyle": "line",
                        "lineWidth": 2,
                        "fillOpacity": 10,
                        "lineInterpolation": "smooth",
                        "showPoints": "never",
                        "spanNulls": true,
                        "thresholdsStyle": {
                            "mode": "off"
                        }
                    }
                },
                "overrides": []
            },
            "targets": [
                {
                    "expr": "trustscale_node_discrepancy",
                    "legendFormat": "{{node_id}}",
                    "refId": "A"
                }
            ]
        },
        {
            "id": 4,
            "title": "Request Distribution per Node",
            "type": "timeseries",
            "gridPos": {
                "x": 12,
                "y": 8,
                "w": 12,
                "h": 8
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "desc"
                }
            },
            "fieldConfig": {
                "defaults": {
                    "min": 0,
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "drawStyle": "bars",
                        "lineWidth": 1,
                        "fillOpacity": 100,
                        "gradientMode": "none",
                        "showPoints": "never",
                        "barAlignment": 0,
                        "stacking": {
                            "mode": "normal",
                            "group": "A"
                        }
                    }
                },
                "overrides": []
            },
            "targets": [
                {
                    "expr": "trustscale_node_requests_last_30s",
                    "legendFormat": "{{node_id}}",
                    "refId": "A"
                }
            ]
        },
        {
            "id": 5,
            "title": "Quarantine Count",
            "type": "stat",
            "gridPos": {
                "x": 0,
                "y": 16,
                "w": 8,
                "h": 5
            },
            "options": {
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "colorMode": "background",
                "graphMode": "none",
                "orientation": "horizontal",
                "textMode": "value_and_name"
            },
            "fieldConfig": {
                "defaults": {
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "value": null,
                                "color": "dark-green"
                            },
                            {
                                "value": 1,
                                "color": "orange"
                            },
                            {
                                "value": 5,
                                "color": "red"
                            },
                            {
                                "value": 10,
                                "color": "dark-red"
                            }
                        ]
                    },
                    "color": {
                        "mode": "thresholds"
                    }
                },
                "overrides": []
            },
            "targets": [
                {
                    "expr": "trustscale_node_quarantine_count",
                    "legendFormat": "{{node_id}}",
                    "refId": "A"
                }
            ]
        },
        {
            "id": 6,
            "title": "Quarantine Status",
            "type": "stat",
            "gridPos": {
                "x": 8,
                "y": 16,
                "w": 8,
                "h": 5
            },
            "options": {
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "colorMode": "background",
                "graphMode": "none",
                "orientation": "horizontal",
                "textMode": "value_and_name"
            },
            "fieldConfig": {
                "defaults": {
                    "mappings": [
                        {
                            "type": "value",
                            "options": {
                                "0": {
                                    "text": "ACTIVE",
                                    "color": "green"
                                }
                            }
                        },
                        {
                            "type": "value",
                            "options": {
                                "1": {
                                    "text": "QUARANTINED",
                                    "color": "dark-red"
                                }
                            }
                        }
                    ],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "value": null,
                                "color": "green"
                            },
                            {
                                "value": 1,
                                "color": "dark-red"
                            }
                        ]
                    },
                    "color": {
                        "mode": "thresholds"
                    }
                },
                "overrides": []
            },
            "targets": [
                {
                    "expr": "trustscale_node_is_quarantined",
                    "legendFormat": "{{node_id}}",
                    "refId": "A"
                }
            ]
        },
        {
            "id": 7,
            "title": "Average Response Time per Node (ms)",
            "type": "timeseries",
            "gridPos": {
                "x": 16,
                "y": 16,
                "w": 8,
                "h": 5
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "desc"
                }
            },
            "fieldConfig": {
                "defaults": {
                    "min": 0,
                    "unit": "ms",
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "drawStyle": "line",
                        "lineWidth": 1,
                        "fillOpacity": 10,
                        "lineInterpolation": "smooth",
                        "showPoints": "never",
                        "spanNulls": true
                    }
                },
                "overrides": []
            },
            "targets": [
                {
                    "expr": "trustscale_node_avg_response_time_ms",
                    "legendFormat": "{{node_id}}",
                    "refId": "A"
                }
            ]
        }
    ]
}